# ===== 用户端环境变量三件套（docs/frontend/前端架构设计与工程约定.md §2）=====
# 复制为 .env.local 按需覆盖；.env 不入库（仓库只保留 .env.example 与 .env.development）

# mock：走工程内 src/mocks/ 演示数据（离线可跑，不依赖后端）
# real：走真实后端接口
VITE_API_MODE=mock

# real 模式接口地址（本地后端 http://127.0.0.1:4000，接口统一 /api/v1 前缀）
VITE_API_BASE_URL=http://127.0.0.1:4000/api/v1

# real 请求失败是否自动回退 mock；联调阶段必须为 false（9/7 晚后全链路关闭回退）
VITE_MOCK_FALLBACK=false

# ===== vite dev server 端口与代理目标（PR #36 评审引入，本地一般无需设置） =====
# 本地默认 5173 + 契约默认后端 4000；服务器部署在 .env.development.local 覆盖：
# VITE_DEV_PORT=5174
# VITE_PROXY_TARGET=http://127.0.0.1:4000（后端实际挂载端口，见 BUG-007 口径）
