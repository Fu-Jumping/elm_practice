// ================= 渲染逻辑 =================
const $ = (sel) => document.querySelector(sel);

// 使用侧卡片
function renderCards(containerId, flows) {
  const wrap = $(containerId);
  flows.forEach(f => {
    const div = document.createElement('div');
    div.className = 'card';
    div.innerHTML =
      '<div class="fr">' + f.fr + ' · ' + f.name + '</div>' +
      '<div class="meta"><b>PRD 来源</b>：' + f.prd + '　<b>接口</b>：' + f.api + '</div>' +
      '<div class="meta"><b>测试</b>：' + f.tc + '</div>' +
      '<div class="detail"><b>正常验收：</b>' + f.ok + '<br><b>异常验收：</b>' + f.err + '</div>' +
      '<div class="toggle">展开验收 ▾</div>';
    div.querySelector('.toggle').addEventListener('click', () => div.classList.toggle('open'));
    wrap.appendChild(div);
  });
}
renderCards('#user-cards', userFlows);
renderCards('#merchant-cards', merchantFlows);

// 后端分层
function renderBackend() {
  const wrap = $('#backend-layers');
  backendLayers.forEach(layer => {
    const col = document.createElement('div');
    col.className = 'layer';
    col.innerHTML = '<h3>' + layer.name + '</h3><div style="font-size:12px;color:#888;margin-bottom:10px">' + layer.desc + '</div>';
    layer.items.forEach(it => {
      const chip = document.createElement('div');
      chip.className = 'chip';
      chip.innerHTML = '<span class="fr">' + it.fr + '</span>：' + it.what;
      col.appendChild(chip);
    });
    wrap.appendChild(col);
  });
}
renderBackend();

// 数据库表格
function renderDb() {
  const wrap = $('#db-tables');
  dbTables.forEach(tbl => {
    const h = document.createElement('div');
    h.className = 'db-table';
    let rows = '<h3>表 <code>' + tbl.name + '</code></h3><table><thead><tr><th>字段</th><th>标记</th><th>类型</th><th>约束/说明</th></tr></thead><tbody>';
    tbl.fields.forEach(f => {
      const mark = f[1];
      const cls = mark === 'PK' ? 'pk' : (mark.includes('FK') ? 'fk' : '');
      rows += '<tr><td>' + f[0] + '</td><td class="' + cls + '">' + mark + '</td><td>' + f[2] + '</td><td>' + (f[3] || '') + '</td></tr>';
    });
    rows += '</tbody></table>';
    h.innerHTML = rows;
    wrap.appendChild(h);
  });
}
renderDb();

