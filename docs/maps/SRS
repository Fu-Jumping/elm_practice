    varchar contactName
    varchar contactSex
    varchar contactPhone
    varchar region
    varchar detail
    varchar label
    boolean isDefault "最多一个默认"
  }
  CART_ITEM {
    bigint cartLineId PK
    bigint userId FK
    bigint storeId FK
    bigint productId FK
    int quantity ">0; P0合并"
  }
  ORDER {
    bigint orderId PK
    bigint userId FK
    bigint storeId FK
    varchar status "PROCESSING(P0)"
    decimal productSubtotal
    decimal packagingFee "固定2.00"
    decimal totalAmount "=小计+打包费"
    json addressSnapshot
    datetime createdAt
  }
  ORDER_ITEM {
    bigint orderItemId PK
    bigint orderId FK
    bigint productId FK
    varchar productNameSnapshot "快照"
    decimal unitPriceSnapshot "快照"
    int quantity
    decimal lineAmount
  }`;

document.getElementById('er-source').textContent = erSource;
(async function renderEr() {
  const container = document.getElementById('er-container');
  if (typeof mermaid === 'undefined') { container.innerHTML = '<div class="note">mermaid CDN 未加载，请联网后刷新。</div>'; return; }
  try {
    mermaid.initialize({ startOnLoad: false, theme: 'default', er: { useMaxWidth: true } });
    const { svg } = await mermaid.render('erDiagram1', erSource);
    container.innerHTML = svg;
  } catch (e) {
    container.innerHTML = '<div class="note">ER 图渲染失败：' + e.message + '</div>';
  }
})();

// ================= 页签切换 =================
function activate(name) {
  document.querySelectorAll('.pane').forEach(p => p.classList.toggle('active', p.dataset.pane === name));
  document.querySelectorAll('.tab').forEach(t => t.classList.toggle('active', t.dataset.pane === name));
  if (location.hash !== '#' + name) history.replaceState(null, '', '#' + name);
}
document.querySelectorAll('.tab').forEach(b => b.addEventListener('click', () => activate(b.dataset.pane)));
activate(location.hash.replace('#', '') || 'er');
</script>
